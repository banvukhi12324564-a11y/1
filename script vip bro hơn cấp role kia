--==================================================
-- APPLY ROLE
--==================================================

local function ApplyRole(player)

	local role = Roles[string.lower(player.Name)]

	if not role then
		return
	end

	local character = player.Character
	if not character then
		return
	end

	local head = character:FindFirstChild("Head")
	if not head then
		return
	end

	local tag = head:FindFirstChild("NameTag")
	if not tag then
		return
	end

	local main = tag:FindFirstChild("Main")
	if not main then
		return
	end

	local nameLabel = main:FindFirstChild("UserDisplayName")
	local username = main:FindFirstChild("Username")
	local rank = main:FindFirstChild("Rank")

	if not nameLabel or not username or not rank then
		return
	end

	-- ROLE
	rank.Text = role.Title
	rank.TextColor3 = role.TitleColor

	-- MÀU TÊN
	if role.Rainbow then
		RainbowEffect({
			nameLabel,
			username
		})
	else
		nameLabel.TextColor3 = role.Color
		username.TextColor3 = role.Color
	end

	-- ICON
	if role.Icon and role.Icon ~= "" then

		local icon = rank:FindFirstChild("RoleIcon")

		if not icon then
			icon = Instance.new("ImageLabel")
			icon.Name = "RoleIcon"
			icon.BackgroundTransparency = 1
			icon.Size = UDim2.new(0,22,0,22)
			icon.AnchorPoint = Vector2.new(0,0.5)
			icon.Position = UDim2.new(1,5,0.5,0)
			icon.ScaleType = Enum.ScaleType.Fit
			icon.Parent = rank
		end

		icon.Image = role.Icon
		icon.Visible = true
	end
end

--==================================================
-- KHI PLAYER VÀO
--==================================================

Players.PlayerAdded:Connect(function(player)

	-- Role được khai báo sẵn theo username
	LoadRole(player)

	player.CharacterAdded:Connect(function()

		task.wait(1)

		ApplyRole(player)

	end)
end)

--==================================================
-- PLAYER ĐANG Ở SERVER
--==================================================

for _, player in ipairs(Players:GetPlayers()) do

	LoadRole(player)

	if player.Character then
		task.wait(1)
		ApplyRole(player)
	end

	player.CharacterAdded:Connect(function()

		task.wait(1)

		ApplyRole(player)

	end)
end
