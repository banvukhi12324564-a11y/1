--// ================= RAINBOW =================

local function RainbowEffect(labels)

	task.spawn(function()

		local h = 0

		while true do

			for _,label in ipairs(labels) do

				if not label or not label.Parent then
					return
				end

				label.TextColor3 =
					Color3.fromHSV((h % 100)/100,1,1)

			end

			h += 1

			task.wait(0.05)

		end

	end)

end


--// ================= LEVEL COLOR =================

local function GetLevelColor(level)

	if level >= 1 and level <= 20 then

		return "#99ff99"

	elseif level >= 21 then

		return "#f8d96d"

	end

	return "#ffffff"

end


--// ================= CAPRANK FIND =================

local function CapFind(name)

	name = string.lower(name)

	-- Tìm chính xác

	for _,p in ipairs(Players:GetPlayers()) do

		if string.lower(p.Name) == name
			or string.lower(p.DisplayName) == name then

			return p

		end

	end

	-- Tìm gần đúng

	for _,p in ipairs(Players:GetPlayers()) do

		if string.find(
			string.lower(p.Name),
			name,
			1,
			true
		)
		or string.find(
			string.lower(p.DisplayName),
			name,
			1,
			true
		) then

			return p

		end

	end

	return nil

end


--// ================= XÓA ROLE + ICON CŨ =================

local function RemoveOldRoleAndIcon(player)

	local char = player.Character

	if not char then
		return
	end

	local head = char:FindFirstChild("Head")

	if not head then
		return
	end

	local tag = head:FindFirstChild("NameTag")

	if not tag then
		return
	end

	local main = tag:FindFirstChild("Main")

	if not main then
		return
	end

	-- Xóa tất cả icon cũ
	for _,obj in ipairs(main:GetChildren()) do

		if obj.Name == "RoleIcon" then
			obj:Destroy()
		end

	end

	-- Xóa role cũ
	local rank = main:FindFirstChild("Rank")

	if rank then

		rank.Text = ""

		rank.TextColor3 =
			Color3.fromRGB(255,255,255)

	end

end


--// ================= TẠO ICON =================

local function CreateRoleIcon(player, iconId)

	if not iconId or iconId == "" or iconId == "rbxassetid://0" then
		return
	end

	local char = player.Character

	if not char then
		return
	end

	local head = char:FindFirstChild("Head")

	if not head then
		return
	end

	local tag = head:FindFirstChild("NameTag")

	if not tag then
		return
	end

	local main = tag:FindFirstChild("Main")

	if not main then
		return
	end

	-- Xóa icon cũ
	local oldIcon = main:FindFirstChild("RoleIcon")

	if oldIcon then
		oldIcon:Destroy()
	end

	-- Tạo icon
	local icon = Instance.new("ImageLabel")

	icon.Name = "RoleIcon"

	icon.BackgroundTransparency = 1

	icon.Image = iconId

	icon.Size = UDim2.fromOffset(25,25)

	icon.Position = UDim2.new(
		1,
		5,
		0.5,
		0
	)

	icon.AnchorPoint =
		Vector2.new(0,0.5)

	icon.ScaleType =
		Enum.ScaleType.Fit

	icon.ZIndex = 10

	icon.Parent = main

end


--// ================= SAVE ROLE =================

local function SaveRole(player)

	local role = Roles[string.lower(player.Name)]

	if not role then
		return
	end

	pcall(function()

		RoleDataStore:SetAsync(

			"Role_" .. player.UserId,

			{

				Title = role.Title,

				TitleColor = {

					role.TitleColor.R,
					role.TitleColor.G,
					role.TitleColor.B

				},

				Color = {

					role.Color.R,
					role.Color.G,
					role.Color.B

				},

				Rainbow = role.Rainbow == true,

				Icon = role.Icon or ""

			}

		)

	end)

end


--// ================= LOAD ROLE =================

local function LoadRole(player)

	local data

	pcall(function()

		data = RoleDataStore:GetAsync(
			"Role_" .. player.UserId
		)

	end)

	if not data then
		return
	end

	if not data.TitleColor
		or not data.Color then

		return

	end

	Roles[string.lower(player.Name)] = {

		Title = data.Title,

		TitleColor = Color3.new(

			data.TitleColor[1],
			data.TitleColor[2],
			data.TitleColor[3]

		),

		Color = Color3.new(

			data.Color[1],
			data.Color[2],
			data.Color[3]

		),

		Rainbow = data.Rainbow == true,

		Icon = data.Icon or ""

	}

end


--// ================= UPDATE LEVEL =================

local function UpdateLevelDisplay(player)

	local char = player.Character

	if not char then
		return
	end

	local head = char:FindFirstChild("Head")

	if not head then
		return
	end

	local tag = head:FindFirstChild("NameTag")

	if not tag then
		return
	end

	local main = tag:FindFirstChild("Main")

	if not main then
		return
	end

	local nameLabel =
		main:FindFirstChild("UserDisplayName")

	if not nameLabel then
		return
	end

	local rank =
		main:FindFirstChild("Rank")

	local stats =
		PlayerStats[player]

	if not stats then
		return
	end

	local levelColor =
		GetLevelColor(stats.Level)

	nameLabel.RichText = true

	nameLabel.Text =

		'<font color="' ..
		levelColor ..
		'">(Lv ' ..
		stats.Level ..
		')</font> ' ..
		player.DisplayName

	if rank and stats.Level >= 30
		and not Roles[string.lower(player.Name)] then

		rank.Text =
			DanChiRole.Title

		rank.TextColor3 =
			DanChiRole.TitleColor

	end

end


--// ================= APPLY ROLE =================

local function ApplyRole(player)

	local char = player.Character

	if not char then
		return
	end

	local head = char:FindFirstChild("Head")

	if not head then
		return
	end

	local tag = head:FindFirstChild("NameTag")

	if not tag then
		return
	end

	local main = tag:FindFirstChild("Main")

	if not main then
		return
	end

	local nameLabel =
		main:FindFirstChild("UserDisplayName")

	local username =
		main:FindFirstChild("Username")

	local rank =
		main:FindFirstChild("Rank")

	if not nameLabel
		or not username
		or not rank then

		return

	end

	local role =
		Roles[string.lower(player.Name)]

	if role then

		-- XÓA ROLE + ICON CŨ
		RemoveOldRoleAndIcon(player)

		-- ROLE MỚI
		rank.Text =
			role.Title

		rank.TextColor3 =
			role.TitleColor or
			Color3.new(1,1,1)

		-- ICON MỚI
		CreateRoleIcon(
			player,
			role.Icon
		)

		if role.Rainbow then

			RainbowEffect({

				nameLabel,
				username

			})

		else

			nameLabel.TextColor3 =
				role.Color or
				Color3.new(1,1,1)

			username.TextColor3 =
				role.Color or
				Color3.new(1,1,1)

		end

	else

		rank.Text =
			"Người Dân"

		rank.TextColor3 =
			Color3.fromRGB(0,255,0)

	end

end


--// ================= CAPRANK COMMAND =================

local function CapCommand(player,message)

	local args = {}

	-- Hỗ trợ nhiều dấu cách
	for word in string.gmatch(
		message,
		"%S+"
	) do

		table.insert(
			args,
			word
		)

	end

	if string.lower(args[1] or "")
		~= "/caprank" then

		return

	end

	-- KIỂM TRA QUYỀN
	if not CapRankUsers[
		string.lower(player.Name)
	] then

		return

	end

	-- /caprank player role màu màuTên
	if #args < 5 then
		return
	end

	-- TÌM NGƯỜI CHƠI
	local target =
		CapFind(args[2])

	if not target then
		return
	end

	-- ROLE
	local selectedRole =
		CapRoles[
			string.lower(args[3])
		]

	if not selectedRole then
		return
	end

	-- MÀU ROLE
	local roleColor =
		CapColors[
			string.lower(args[4])
		]

	if not roleColor then
		return
	end

	-- RAINBOW / MÀU TÊN
	local rainbow =
		string.lower(args[5])
		== "rainbow"

	local nameColor

	if rainbow then

		nameColor =
			Color3.new(1,1,1)

	else

		nameColor =
			CapColors[
				string.lower(args[5])
			]

		if not nameColor then
			return
		end

	end

	-- ==========================================
	-- XÓA ROLE + ICON CŨ
	-- ==========================================

	RemoveOldRoleAndIcon(target)

	-- ==========================================
	-- GHI ROLE MỚI
	-- ==========================================

	Roles[
		string.lower(target.Name)
	] = {

		Title =
			selectedRole.Title,

		TitleColor =
			roleColor,

		Color =
			nameColor,

		Rainbow =
			rainbow,

		Icon =
			selectedRole.Icon or ""

	}

	-- ==========================================
	-- LƯU VĨNH VIỄN
	-- ==========================================

	SaveRole(target)

	-- ==========================================
	-- ÁP DỤNG NGAY
	-- ==========================================

	ApplyRole(target)

	print(
		"[CAPRANK] " ..
		player.Name ..
		" -> " ..
		target.Name ..
		" -> " ..
		selectedRole.Title
	)

end


--// ================= CHAT COMMAND SETUP =================

local function SetupCapRank(player)

	player.Chatted:Connect(function(message)

		CapCommand(
			player,
			message
		)

	end)

end


--// ================= PLAYER JOIN =================

Players.PlayerAdded:Connect(function(player)

	-- LOAD ROLE VĨNH VIỄN
	LoadRole(player)

	-- LOAD LEVEL
	local success,data =
		pcall(function()

			return LevelData:GetAsync(
				player.UserId
			)

		end)

	if success and data then

		PlayerStats[player] =
			data

	else

		PlayerStats[player] = {

			Level = 1

		}

	end

	-- SETUP COMMAND
	SetupCapRank(player)

	-- 3 PHÚT = 1 LEVEL
	task.spawn(function()

		while player.Parent do

			task.wait(180)

			local stats =
				PlayerStats[player]

			if stats
				and stats.Level < MAX_LEVEL then

				stats.Level += 1

				UpdateLevelDisplay(player)

			end

		end

	end)


	-- CHARACTER
	player.CharacterAdded:Connect(function(char)

		task.wait(1)

		local function ApplyNameTag()

			local head =
				char:FindFirstChild("Head")

			if not head then
				return
			end

			-- XÓA NAMETAG CŨ
			local old =
				head:FindFirstChild("NameTag")

			if old then
				old:Destroy()
			end

			-- CLONE NAMETAG
			local tag =
				NameTagTemplate:Clone()

			tag.Name =
				"NameTag"

			tag.Parent =
				head

			tag.AlwaysOnTop =
				true

			tag.StudsOffset =
				Vector3.new(0,3.2,0)

			local main =
				tag:WaitForChild("Main")

			local nameLabel =
				main:WaitForChild(
					"UserDisplayName"
				)

			local username =
				main:WaitForChild(
					"Username"
				)

			local rank =
				main:WaitForChild(
					"Rank"
				)

			username.Text =
				"@" .. player.Name

			-- LEVEL
			UpdateLevelDisplay(player)

			-- ROLE
			ApplyRole(player)

		end

		ApplyNameTag()

		char.ChildAdded:Connect(
			function(child)

				if child.Name == "Head" then

					task.wait(0.5)

					ApplyNameTag()

				end

			end
		)

	end)

end)


--// ================= SAVE =================

Players.PlayerRemoving:Connect(function(player)

	-- SAVE ROLE
	SaveRole(player)

	-- SAVE LEVEL
	local stats =
		PlayerStats[player]

	if stats then

		pcall(function()

			LevelData:SetAsync(

				player.UserId,

				stats

			)

		end)

	end

	PlayerStats[player] =
		nil

end)


