local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")

local SkinStore = DataStoreService:GetDataStore("PermanentCharSkin_V4")

--------------------------------------------------
-- HÀM LƯU SKIN
--------------------------------------------------

local function SaveSkin(player, description)
	if not player or not description then
		return false
	end

	local data = {}

	local properties = {
		-- Accessories
		"BackAccessory",
		"FaceAccessory",
		"FrontAccessory",
		"HairAccessory",
		"HatAccessory",
		"NeckAccessory",
		"ShouldersAccessory",
		"WaistAccessory",

		-- Clothes
		"Face",
		"Head",
		"Shirt",
		"Pants",
		"GraphicTShirt",

		-- Body Colors
		"HeadColor",
		"LeftArmColor",
		"LeftLegColor",
		"RightArmColor",
		"RightLegColor",
		"TorsoColor",

		-- Body Scale
		"BodyTypeScale",
		"DepthScale",
		"HeadScale",
		"HeightScale",
		"ProportionScale",
		"WidthScale",

		-- Animations
		"ClimbAnimation",
		"FallAnimation",
		"IdleAnimation",
		"JumpAnimation",
		"RunAnimation",
		"SwimAnimation",
		"WalkAnimation",

		-- Emotes
		"EmotesData",
		"EquippedEmotesData",
	}

	for _, property in ipairs(properties) do
		local success, value = pcall(function()
			return description[property]
		end)

		if success then
			data[property] = value
		end
	end

	local success, err = pcall(function()
		-- Skin mới ghi đè skin cũ
		SkinStore:SetAsync(
			"Player_" .. player.UserId,
			data
		)
	end)

	if not success then
		warn(
			"[CHAR] Lỗi lưu skin của "
				.. player.Name
				.. ": "
				.. tostring(err)
		)

		return false
	end

	return true
end

--------------------------------------------------
-- XÓA SKIN ĐÃ LƯU
--------------------------------------------------

local function RemoveSavedSkin(player)
	local success, err = pcall(function()
		SkinStore:RemoveAsync(
			"Player_" .. player.UserId
		)
	end)

	if not success then
		warn(
			"[CHAR] Lỗi xóa skin của "
				.. player.Name
				.. ": "
				.. tostring(err)
		)

		return false
	end

	return true
end

--------------------------------------------------
-- LOAD SKIN
--------------------------------------------------

local function LoadSkin(player)
	local success, data = pcall(function()
		return SkinStore:GetAsync(
			"Player_" .. player.UserId
		)
	end)

	if not success then
		warn(
			"[CHAR] Không thể load skin của "
				.. player.Name
		)

		return nil
	end

	if not data then
		return nil
	end

	local description =
		Instance.new("HumanoidDescription")

	for property, value in pairs(data) do
		pcall(function()
			description[property] = value
		end)
	end

	return description
end

--------------------------------------------------
-- ÁP DỤNG SKIN
--------------------------------------------------

local function ApplySkin(player, description)
	if not player.Character then
		return false
	end

	local humanoid =
		player.Character:FindFirstChildOfClass(
			"Humanoid"
		)

	if not humanoid then
		return false
	end

	local success, err = pcall(function()
		humanoid:ApplyDescription(description)
	end)

	if not success then
		warn(
			"[CHAR] Lỗi áp dụng skin: "
				.. tostring(err)
		)

		return false
	end

	return true
end

--------------------------------------------------
-- /CHAR
-- /char TênNgườiChơi
--------------------------------------------------

local function ChangeChar(player, targetName)
	if not targetName or targetName == "" then
		return
	end

	local success, userId = pcall(function()
		return Players:GetUserIdFromNameAsync(
			targetName
		)
	end)

	if not success or not userId then
		warn(
			"[CHAR] Không tìm thấy người chơi: "
				.. targetName
		)

		return
	end

	local success2, description = pcall(function()
		return Players:GetHumanoidDescriptionFromUserId(
			userId
		)
	end)

	if not success2 or not description then
		warn(
			"[CHAR] Không lấy được skin của "
				.. targetName
		)

		return
	end

	-- Đổi sang skin mới
	local applied =
		ApplySkin(
			player,
			description
		)

	if not applied then
		return
	end

	-- LƯU NGAY SKIN MỚI
	-- Skin cũ sẽ bị ghi đè
	local saved =
		SaveSkin(
			player,
			description
		)

	if saved then
		print(
			"[CHAR] "
				.. player.Name
				.. " đã đổi sang "
				.. targetName
				.. " và lưu skin mới."
		)
	end
end

--------------------------------------------------
-- /RE
-- Respawn nhân vật
--------------------------------------------------

local function RespawnPlayer(player)
	if not player then
		return
	end

	player:LoadCharacter()
end

--------------------------------------------------
-- /UNCHAR
-- Xóa skin đã lưu
--------------------------------------------------

local function UncharPlayer(player)
	if not player then
		return
	end

	local removed =
		RemoveSavedSkin(player)

	if not removed then
		return
	end

	-- Respawn để trở về avatar bình thường
	player:LoadCharacter()

	print(
		"[CHAR] "
			.. player.Name
			.. " đã dùng /unchar. Skin đã lưu bị xóa."
	)
end

--------------------------------------------------
-- SETUP PLAYER
--------------------------------------------------

local function SetupPlayer(player)

	--------------------------------------------------
	-- CHAT COMMAND
	--------------------------------------------------

	player.Chatted:Connect(function(message)

		local args =
			string.split(
				message,
				" "
			)

		local command =
			string.lower(
				args[1] or ""
			)

		--------------------------------------------------
		-- /CHAR
		--------------------------------------------------

		if command == "/char" then

			local targetName =
				args[2]

			if targetName then
				ChangeChar(
					player,
					targetName
				)
			end

		--------------------------------------------------
		-- /RE
		--------------------------------------------------

		elseif command == "/re" then

			RespawnPlayer(player)

		--------------------------------------------------
		-- /UNCHAR
		--------------------------------------------------

		elseif command == "/unchar" then

			UncharPlayer(player)

		end
	end)

	--------------------------------------------------
	-- KHI CHARACTER SPAWN
	--------------------------------------------------

	player.CharacterAdded:Connect(function(character)

		local humanoid =
			character:WaitForChild(
				"Humanoid",
				10
			)

		if not humanoid then
			return
		end

		task.wait(1)

		--------------------------------------------------
		-- KIỂM TRA SKIN ĐÃ LƯU
		--------------------------------------------------

		local savedSkin =
			LoadSkin(player)

		if savedSkin then

			ApplySkin(
				player,
				savedSkin
			)

			print(
				"[CHAR] Đã khôi phục skin của "
					.. player.Name
			)
		end
	end)
end

--------------------------------------------------
-- PLAYER JOIN
--------------------------------------------------

Players.PlayerAdded:Connect(
	SetupPlayer
)

--------------------------------------------------
-- PLAYER LEAVE
--------------------------------------------------

Players.PlayerRemoving:Connect(function(player)

	local character =
		player.Character

	if not character then
		return
	end

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	if not humanoid then
		return
	end

	local success, description =
		pcall(function()
			return humanoid:GetAppliedDescription()
		end)

	if success and description then

		-- Lưu skin hiện tại lần cuối
		SaveSkin(
			player,
			description
		)
	end
end)
